import numpy as np
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider
from statistics import NormalDist

nd = NormalDist(0, 1)


def f1(x):
    return 100 * nd.cdf(np.log(x / 273.5) / 1.37)


def f2(x):
    return 100 * nd.cdf(np.log(x / 564.7) / 1.13)


# NormalDist.cdf работает со скалярами, поэтому векторизуем
f1v = np.vectorize(f1)
f2v = np.vectorize(f2)

X_MAX = 3000
X0 = 850

x = np.linspace(1, X_MAX, 2000)

fig, ax = plt.subplots(figsize=(9, 6))
plt.subplots_adjust(bottom=0.2)

ax.plot(x, f1v(x), color="tab:red", label="y=100·Φ(ln(x/273.5)/1.37)")
ax.plot(x, f2v(x), color="tab:blue", label="y=100·Φ(ln(x/564.7)/1.13)")

# Вертикальная линия X=850 при 0 ≤ y ≤ 100
vline, = ax.plot([X0, X0], [0, 100], color="green", lw=2, label=f"x={X0}")

# Точки пересечения и подписи значений
pt1, = ax.plot([X0], [f1(X0)], "o", color="tab:red")
pt2, = ax.plot([X0], [f2(X0)], "o", color="tab:blue")
info = ax.text(
    0.02, 0.95, "", transform=ax.transAxes, va="top",
    bbox=dict(boxstyle="round", fc="white", ec="gray"),
)


def update_info(val):
    return (f"x = {val:.0f}\n"
            f"y₁ = {f1(val):.2f}\n"
            f"y₂ = {f2(val):.2f}")


info.set_text(update_info(X0))

ax.set_xlim(0, X_MAX)
ax.set_ylim(0, 100)
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.grid(True, alpha=0.3)
ax.legend(loc="lower right")

# Ползунок внизу графика
ax_slider = plt.axes([0.15, 0.06, 0.7, 0.04])
slider = Slider(ax_slider, "X", 1, X_MAX, valinit=X0, valstep=1)


def update(val):
    vline.set_xdata([val, val])
    vline.set_label(f"x={val:.0f}")
    pt1.set_data([val], [f1(val)])
    pt2.set_data([val], [f2(val)])
    info.set_text(update_info(val))
    ax.legend(loc="lower right")
    fig.canvas.draw_idle()


slider.on_changed(update)

plt.show()
